# Get this from your Resend dashboard.
RESEND_API_KEY=re_replace_with_your_real_key

# Where consultation requests should be delivered.
CONTACT_TO_EMAIL=info@qualitybenchmarksolutions.com

# Must use a sender address/domain verified in Resend.
EMAIL_FROM=Quality Benchmark Solutions <consultations@qualitybenchmarksolutions.com>

# Optional but recommended for links in acknowledgement emails.
NEXT_PUBLIC_SITE_URL=https://www.qualitybenchmarksolutions.com
